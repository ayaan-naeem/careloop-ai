# ==============================================================================
# CareLoop AI Configuration
# ==============================================================================

# Supabase Configuration
# To use Supabase Cloud:
# 1. Create a free project at https://supabase.com
# 2. Run backend/supabase_schema.sql in the Supabase SQL Editor
# 3. Copy your Project URL and anon/service_role key from Project Settings -> API
# 4. Paste them here:
SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Periodic Check Interval (seconds)
LOW_STOCK_CHECK_SECONDS=300
RECOVERY_SCAN_SECONDS=300

# Optional Fastn MCP Configuration
FASTN_API_KEY=
FASTN_SPACE_ID=
